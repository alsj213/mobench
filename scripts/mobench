#!/usr/bin/env python3
"""Thin entrypoint for the mobench core.

Runs the mobench package from this checkout regardless of CWD. After
`pip install .` the same functionality is available as the `mobench`
console script.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from mobench.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
